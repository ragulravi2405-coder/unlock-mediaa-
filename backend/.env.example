# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration
MONGODB_URI=mongodb://127.0.0.1:27017/pay_unlock_db

# Client and Host URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Razorpay Configuration (Use test keys during development)
# Get keys from Razorpay Dashboard: Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_SampleKeyId1234
RAZORPAY_KEY_SECRET=SampleSecretKey5678
RAZORPAY_WEBHOOK_SECRET=SampleWebhookSecretKey9012

# Admin Authentication & Security Secrets
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_chars
TOKEN_SALT=replace_with_a_random_salt_for_access_token_hashing

# Initial Admin Credentials (used during auto-seed if admin doesn't exist)
ADMIN_EMAIL=admin@unlockmedia.com
ADMIN_PASSWORD=AdminSecurePass123!

# Storage Configuration ('local' or 's3')
STORAGE_DRIVER=local

# AWS / Cloudflare R2 / S3-compatible configuration (if STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key
AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your_private_s3_bucket_name
AWS_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# Support & Contact Details
SUPPORT_EMAIL=support@unlockmedia.in
SUPPORT_PHONE=+91 98765 43210
BUSINESS_NAME=UnlockMedia Studio
BUSINESS_ADDRESS=Indiranagar, Bengaluru, Karnataka, India - 560038
