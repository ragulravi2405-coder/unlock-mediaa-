# ========================================================
# UnlockMedia — Pay-to-Unlock Production Environment Variables
# ========================================================

# Server & Environment
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas in Production or Local MongoDB in Dev)
# Atlas URI Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pay_unlock_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pay_unlock_db

# Frontend and Backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Razorpay Configuration (Get from https://dashboard.razorpay.com -> Settings -> API Keys)
# Test Mode prefix: rzp_test_... | Live Mode prefix: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_SampleKeyId1234
RAZORPAY_KEY_SECRET=SampleSecretKey5678

# Webhook Secret (Configure webhook in Razorpay Dashboard pointing to https://<backend-domain>/api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=SampleWebhookSecretKey9012

# JWT & Cryptographic Security Secrets (Use long random 32+ character strings)
JWT_SECRET=super_secret_jwt_pay_to_unlock_key_minimum_32_characters_long
TOKEN_SALT=salt_crypto_random_tokens_for_purchases_998877

# Initial Administrator Credentials (auto-seeded on first run if database is empty)
ADMIN_EMAIL=admin@unlockmedia.com
ADMIN_PASSWORD=AdminSecurePass123!

# Storage Configuration ('local' for disk storage, 's3' for AWS S3 or Cloudflare R2)
STORAGE_DRIVER=local

# AWS S3 / Cloudflare R2 Credentials (Required if STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=your_s3_or_r2_access_key
AWS_SECRET_ACCESS_KEY=your_s3_or_r2_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=unlockmedia-private-originals
AWS_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# Customer Support & Studio Details (Used across legal pages and email alerts)
SUPPORT_EMAIL=support@unlockmedia.in
SUPPORT_PHONE=+91 98765 43210
BUSINESS_NAME=UnlockMedia Studio
BUSINESS_ADDRESS=100 Feet Road, Indiranagar, Bengaluru, Karnataka, India - 560038
